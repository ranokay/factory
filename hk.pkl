amends "profiles/universal/hk.pkl"

import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "pkl:json"

local lock = new json.Parser {}.parse(read("skills.lock"))
local vendored = lock.skills.fold(List(), (acc, skill) -> acc.add("skills/\(skill.name)/**"))
local const universalMise = """
  include = ["git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0"]
  """
local const universalHk = """
  amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/universal/hk.pkl"
  """

steps {
  ["codacy-gate-test"] = new Step {
    check = "python3 {{root}}/scripts/codacy-gate-test.py"
    tests {
      ["runs private analysis and rejects zero tools"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["repo-settings-test"] = new Step {
    check = "python3 {{root}}/scripts/repo-settings-test.py"
    tests {
      ["reconciles repository settings idempotently"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["workflow-invariant"] = new Step {
    check = "python3 {{root}}/scripts/workflow-invariant.py {{root}}/.github/workflows"
  }
  ["renovate-config"] = new Step {
    check = "sh {{root}}/scripts/renovate-config-check.sh"
  }
  ["renovate-managers-test"] = new Step {
    check = "python3 {{root}}/scripts/renovate-managers-test.py"
    tests {
      ["extracts every Factory tag pin once"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["renovate-re2-test"] = new Step {
    check = "sh {{root}}/scripts/renovate-re2-test.sh"
    tests {
      ["both Renovate steps reject the RE2 fallback"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["workflow-invariant-test"] = new Step {
    check = "python3 {{root}}/scripts/workflow-invariant-test.py"
    tests {
      ["rejects an unsafe fork workflow"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["advisory-review-requests"] = new Step {
    check = "python3 {{root}}/skills/babysit-pr/scripts/request-advisory-reviews-test.py"
    tests {
      ["requests once and requires outside contributor approval"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["typos"] {
    exclude = vendored
  }
  ["comment-ban"] {
    exclude = List("profiles/universal/tests/fixtures/**")
  }
  ["gitleaks"] = (Builtins.gitleaks) {
    check = "sh {{root}}/scripts/gitleaks-check.sh"
    tests = new Mapping<String, Config.StepTest> {
      ["the Factory scans clean"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "repo" }
        expect { code = 0 }
      }
      ["the Context7 rule fires on a fabricated key"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "fabricated" }
        expect { code = 0 }
      }
      ["an env reference is not a secret"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "env-reference" }
        expect { code = 0 }
      }
      ["a bare Context7 key is detected"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "bare-key" }
        expect { code = 0 }
      }
      ["a ctx7 URL host is not a key"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "url-host" }
        expect { code = 0 }
      }
      ["a key under the CONTEXT7_API_KEY name is detected"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "named-value" }
        expect { code = 0 }
      }
      ["the default rules still fire"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "default-rules" }
        expect { code = 0 }
      }
    }
  }
  ["profiles"] = new Step {
    check = "sh {{root}}/scripts/profiles-check.sh"
    tests {
      ["a matching fixture passes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = ["git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0"]

            [task_config]
            includes = ["git::https://github.com/ranokay/factory.git//profiles/universal/tasks.toml?ref=v0.2.0"]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/universal/hk.pkl"

            import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a task include provides a Profile"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, python\n"
          ["mise.toml"] = """
            include = ["git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0"]

            [task_config]
            includes = ["git::https://github.com/ranokay/factory.git//profiles/python/tasks.toml?ref=v0.2.0"]
            """
          ["hk.pkl"] = universalHk
        }
        expect { code = 0 }
      }
      ["a typescript fixture matches its includes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, typescript\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/mise.toml?ref=v0.2.0",
            ]

            [task_config]
            includes = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/tasks.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/tasks.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/typescript/hk.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a web fixture matches its includes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, typescript, web\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/web/mise.toml?ref=v0.2.0",
            ]

            [task_config]
            includes = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/tasks.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/tasks.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/web/tasks.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/web/hk.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a swift fixture matches its includes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, swift\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/swift/mise.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/swift/hk.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a apple fixture matches its includes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, swift, apple\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/swift/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/apple/mise.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/apple/hk.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a go fixture matches its includes"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, go\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/go/mise.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/go/hk.pkl"
            """
        }
        expect { code = 0 }
      }
      ["a web include the line does not declare fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, typescript\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/web/mise.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/v0.2.0/profiles/typescript/hk.pkl"
            """
        }
        expect {
          code = 1
          stderr = "does not declare web"
        }
      }
      ["a non-Factory include is ignored"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/other/shared.git//profiles/typescript/mise.toml?ref=main",
            ]
            """
          ["hk.pkl"] = universalHk
        }
        expect { code = 0 }
      }
      ["an include the line does not declare fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/typescript/mise.toml?ref=v0.2.0",
            ]
            """
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "does not declare typescript"
        }
      }
      ["a declared Profile with no include fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal, typescript\n"
          ["mise.toml"] = universalMise
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "declares typescript"
        }
      }
      ["a branch ref fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = ["git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=main"]
            """
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "pin a Factory tag"
        }
      }
      ["an unpinned mise include fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = ["git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml"]
            """
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "has no ref"
        }
      }
      ["an hk branch fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = universalMise
          ["hk.pkl"] = """
            amends "https://raw.githubusercontent.com/ranokay/factory/main/profiles/universal/hk.pkl"
            """
        }
        expect {
          code = 1
          stderr = "pin a Factory tag"
        }
      }
      ["a branch in another Factory URL shape fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = universalMise
          ["hk.pkl"] = """
            amends "https://github.com/ranokay/factory/blob/main/profiles/universal/hk.pkl"
            """
        }
        expect {
          code = 1
          stderr = "pin a Factory tag"
        }
      }
      ["a Factory include outside profiles is still pinned"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//skills/evidence?ref=main",
            ]
            """
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "pin a Factory tag"
        }
      }
      ["a monorepo checks each package against its own line"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = universalMise
          ["packages/api/AGENTS.md"] = "Profiles: universal, python\n"
          ["packages/api/mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/python/mise.toml?ref=v0.2.0",
            ]
            """
        }
        expect { code = 0 }
      }
      ["a monorepo mismatch names the package"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = universalMise
          ["packages/api/AGENTS.md"] = "Profiles: universal\n"
          ["packages/api/mise.toml"] = """
            include = [
              "git::https://github.com/ranokay/factory.git//profiles/universal/mise.toml?ref=v0.2.0",
              "git::https://github.com/ranokay/factory.git//profiles/python/mise.toml?ref=v0.2.0",
            ]
            """
        }
        expect {
          code = 1
          stderr = "packages/api/AGENTS.md does not declare python"
        }
      }
      ["an AGENTS.md-only package is checked"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "Profiles: universal\n"
          ["mise.toml"] = universalMise
          ["packages/api/AGENTS.md"] = "Profiles: python\n"
        }
        expect {
          code = 1
          stderr = "packages/api/AGENTS.md declares python"
        }
      }
      ["a fenced example is not a declaration"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = """
            # repo

            ```md
            Profiles: typescript
            ```

            Profiles: universal
            """
          ["mise.toml"] = universalMise
          ["hk.pkl"] = universalHk
        }
        expect { code = 0 }
      }
      ["a package without a Profiles line fails"] {
        run = "check"
        tmpdir = true
        write {
          ["AGENTS.md"] = "# repo\n"
          ["mise.toml"] = universalMise
          ["hk.pkl"] = universalHk
        }
        expect {
          code = 1
          stderr = "has no Profiles line"
        }
      }
      ["the Factory declares what it includes"] {
        run = "check"
        expect { code = 0 }
      }
    }
  }
  ["editorconfig-checker"] {
    exclude = vendored
  }
  ["shellcheck"] {
    exclude = List("skills/wizard/template.sh")
  }
  ["shfmt"] {
    exclude = List(
      "skills/wizard/template.sh",
      "skills/diagnosing-bugs/scripts/hitl-loop.template.sh",
      "skills/statechart/scripts/statechart",
    )
  }
  ["skills-sync"] = new Step {
    check = "uv run {{root}}/scripts/skills-sync.py --check --root ."
    fix = "uv run {{root}}/scripts/skills-sync.py --root ."
    tests {
      local const fixture = "uv run {{root}}/scripts/skills-sync-fixture.py"
      ["check accepts a clean fixture"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) clean"
        expect { code = 0 }
      }
      ["the mise task runs the check"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) clean && mise --cd {{root}} run skills:sync --check --root {{tmp}} > task.log"
        after = "grep -q 'check passed for 3 vendored skills' task.log"
        expect { code = 0 }
      }
      ["check rejects a hand-edited file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) edit"
        expect {
          code = 1
          stderr = "skills/alpha/SKILL.md"
        }
      }
      ["check rejects an added file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) add"
        expect {
          code = 1
          stderr = "skills/alpha/extra.md"
        }
      }
      ["check rejects a deleted file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) delete"
        expect {
          code = 1
          stderr = "skills/alpha/reference.md"
        }
      }
      ["sync re-applies a patch"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) patch"
        expect {
          code = 0
          files {
            ["skills/alpha/SKILL.md"] = "patched alpha\n"
          }
        }
      }
      ["sync names a conflicting patch"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) patch-conflict"
        expect {
          code = 1
          stderr = "patches/alpha/0001-alpha.patch"
        }
      }
      ["update prints the upstream diff"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) update && uv run {{root}}/scripts/skills-sync.py --update --root . > update.log"
        after = "grep -q '^-alpha$' update.log && grep -q '^+alpha v2$' update.log"
        expect {
          code = 0
          files {
            ["skills/alpha/SKILL.md"] = "alpha v2\n"
          }
        }
      }
      ["fetch check rejects a tampered file and lock"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) tamper"
        after = "if uv run {{root}}/scripts/skills-sync.py --check --fetch --root . > fetch.log 2>&1; then cat fetch.log; exit 1; fi; grep -q 'differs from upstream' fetch.log"
        expect { code = 0 }
      }
      ["check rejects a dangling skill reference"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) dangling-reference"
        expect {
          code = 1
          stderr = "references ../missing/SKILL.md but skills/missing does not exist"
        }
      }
      ["check rejects a dropped model-invocation flag"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) human-only"
        expect {
          code = 1
          stderr = "must keep disable-model-invocation: true"
        }
      }
      ["check rejects a patch directory with no lock entry"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) orphan-patch"
        expect {
          code = 1
          stderr = "patches/orphan: no lock entry"
        }
      }
      ["check rejects a tampered patch file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) patch-tamper"
        expect {
          code = 1
          stderr = "patches/alpha/0001-alpha.patch"
        }
      }
      ["sync leaves a directory with no lock entry alone"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) own-skill"
        expect {
          code = 0
          files {
            ["skills/own-skill/SKILL.md"] = "own\n"
          }
        }
      }
      ["sync leaves a tool-owned directory alone"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) tool-skill"
        expect {
          code = 0
          files {
            ["skills/ardia/SKILL.md"] = "tool\n"
          }
        }
      }
    }
  }

  ["run-slot"] = new Step {
    check = "sh {{root}}/skills/full-send/scripts/run-slot-test.sh"
    tests {
      ["two slots succeed"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "two" }
        expect { code = 0 }
      }
      ["a third repo is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "third" }
        expect { code = 0 }
      }
      ["a second slot for the same repo is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "same" }
        expect { code = 0 }
      }
      ["release frees a slot"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "release" }
        expect { code = 0 }
      }
      ["a traversal is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "traversal" }
        expect { code = 0 }
      }
      ["a permission failure is not a duplicate"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "permission" }
        expect { code = 0 }
      }
      ["concurrent acquires admit exactly two"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "concurrent" }
        expect { code = 0 }
      }
      ["glob characters in the slot root are literal"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "glob_root" }
        expect { code = 0 }
      }
      ["newlines preserve live slots"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "newline_root" }
        expect { code = 0 }
      }
      ["trailing slashes preserve slot names"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "trailing_root" }
        expect { code = 0 }
      }
      ["a leading dash in the slot root is literal"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "dash_root" }
        expect { code = 0 }
      }
      ["relative slot roots ignore CDPATH"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "cdpath" }
        expect { code = 0 }
      }
      ["a crashed machine slot is pruned"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "orphan" }
        expect { code = 0 }
      }
      ["an owner directory failure names the path"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "owner_permission" }
        expect { code = 0 }
      }
    }
  }

  ["canonical-clones"] = new Step {
    check = "sh {{root}}/scripts/canonical-clones-test.sh"
    tests {
      ["inventory and migration fixtures pass"] {
        run = "check"
        expect { code = 0 }

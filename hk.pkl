amends "profiles/universal/hk.pkl"

import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "pkl:json"

local lock = new json.Parser {}.parse(read("skills.lock"))
local vendored = lock.skills.fold(List(), (acc, skill) -> acc.add("skills/\(skill.name)/**"))

steps {
  ["typos"] {
    exclude = vendored
  }
  ["gitleaks"] = (Builtins.gitleaks) {
    check = "sh {{root}}/scripts/gitleaks-check.sh"
    tests = new Mapping<String, Config.StepTest> {
      ["the Factory scans clean"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "repo" }
        expect { code = 0 }
      }
      ["the Context7 rule fires on a fabricated key"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "fabricated" }
        expect { code = 0 }
      }
      ["an env reference is not a secret"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "env-reference" }
        expect { code = 0 }
      }
      ["the default rules still fire"] {
        run = "check"
        env { ["GITLEAKS_CHECK_CASE"] = "default-rules" }
        expect { code = 0 }
      }
    }
  }
  ["editorconfig-checker"] {
    exclude = vendored
  }
  ["shellcheck"] {
    exclude = List("skills/wizard/template.sh")
  }
  ["shfmt"] {
    exclude = List(
      "skills/wizard/template.sh",
      "skills/diagnosing-bugs/scripts/hitl-loop.template.sh",
      "skills/statechart/scripts/statechart",
    )
  }
  ["skills-sync"] = new Step {
    check = "uv run {{root}}/scripts/skills-sync.py --check --root ."
    fix = "uv run {{root}}/scripts/skills-sync.py --root ."
    tests {
      local const fixture = "uv run {{root}}/scripts/skills-sync-fixture.py"
      ["check accepts a clean fixture"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) clean"
        expect { code = 0 }
      }
      ["the mise task runs the check"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) clean && mise --cd {{root}} run skills:sync --check --root {{tmp}} > task.log"
        after = "grep -q 'check passed for 3 vendored skills' task.log"
        expect { code = 0 }
      }
      ["check rejects a hand-edited file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) edit"
        expect {
          code = 1
          stderr = "skills/alpha/SKILL.md"
        }
      }
      ["check rejects an added file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) add"
        expect {
          code = 1
          stderr = "skills/alpha/extra.md"
        }
      }
      ["check rejects a deleted file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) delete"
        expect {
          code = 1
          stderr = "skills/alpha/reference.md"
        }
      }
      ["sync re-applies a patch"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) patch"
        expect {
          code = 0
          files {
            ["skills/alpha/SKILL.md"] = "patched alpha\n"
          }
        }
      }
      ["sync names a conflicting patch"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) patch-conflict"
        expect {
          code = 1
          stderr = "patches/alpha/0001-alpha.patch"
        }
      }
      ["update prints the upstream diff"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) update && uv run {{root}}/scripts/skills-sync.py --update --root . > update.log"
        after = "grep -q '^-alpha$' update.log && grep -q '^+alpha v2$' update.log"
        expect {
          code = 0
          files {
            ["skills/alpha/SKILL.md"] = "alpha v2\n"
          }
        }
      }
      ["fetch check rejects a tampered file and lock"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) tamper"
        after = "if uv run {{root}}/scripts/skills-sync.py --check --fetch --root . > fetch.log 2>&1; then cat fetch.log; exit 1; fi; grep -q 'differs from upstream' fetch.log"
        expect { code = 0 }
      }
      ["check rejects a dangling skill reference"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) dangling-reference"
        expect {
          code = 1
          stderr = "references ../missing/SKILL.md but skills/missing does not exist"
        }
      }
      ["check rejects a dropped model-invocation flag"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) human-only"
        expect {
          code = 1
          stderr = "must keep disable-model-invocation: true"
        }
      }
      ["check rejects a patch directory with no lock entry"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) orphan-patch"
        expect {
          code = 1
          stderr = "patches/orphan: no lock entry"
        }
      }
      ["check rejects a tampered patch file"] {
        run = "check"
        tmpdir = true
        before = "\(fixture) patch-tamper"
        expect {
          code = 1
          stderr = "patches/alpha/0001-alpha.patch"
        }
      }
      ["sync leaves a directory with no lock entry alone"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) own-skill"
        expect {
          code = 0
          files {
            ["skills/own-skill/SKILL.md"] = "own\n"
          }
        }
      }
      ["sync leaves a tool-owned directory alone"] {
        run = "fix"
        tmpdir = true
        before = "\(fixture) tool-skill"
        expect {
          code = 0
          files {
            ["skills/ardia/SKILL.md"] = "tool\n"
          }
        }
      }
    }
  }

  ["run-slot"] = new Step {
    check = "sh {{root}}/skills/full-send/scripts/run-slot-test.sh"
    tests {
      ["two slots succeed"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "two" }
        expect { code = 0 }
      }
      ["a third repo is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "third" }
        expect { code = 0 }
      }
      ["a second slot for the same repo is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "same" }
        expect { code = 0 }
      }
      ["release frees a slot"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "release" }
        expect { code = 0 }
      }
      ["a traversal is refused"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "traversal" }
        expect { code = 0 }
      }
      ["a permission failure is not a duplicate"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "permission" }
        expect { code = 0 }
      }
      ["concurrent acquires admit exactly two"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "concurrent" }
        expect { code = 0 }
      }
      ["a crashed machine slot is pruned"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "orphan" }
        expect { code = 0 }
      }
      ["an owner directory failure names the path"] {
        run = "check"
        env { ["RUN_SLOT_CASE"] = "owner_permission" }
        expect { code = 0 }
      }
    }
  }

  ["bootstrap"] = new Step {
    check = "sh {{root}}/scripts/bootstrap-test.sh"
    tests {
      ["a fresh temp HOME gets the Factory links"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "fresh" }
        expect { code = 0 }
      }
      ["the second run changes nothing and says so"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "second" }
        expect { code = 0 }
      }
      ["a broken link names the harness and the path"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "broken" }
        expect { code = 0 }
      }
      ["real directories are refused, then backed up with approval"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "refuse" }
        expect { code = 0 }
      }
      ["external symlinks need approval and are backed up"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "external" }
        expect { code = 0 }
      }
      ["linked worktrees are refused for the real home"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "worktree" }
        expect { code = 0 }
      }
      ["skills:sync --check ignores tool-owned skill directories"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "sync" }
        expect { code = 0 }
      }
      ["Codex extras are named and managed entries are ignored"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "codex" }
        expect { code = 0 }
      }
      ["XDG_CONFIG_HOME and CODEX_HOME are honoured"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "env" }
        expect { code = 0 }
      }
      ["the hook helpers still resolve and run"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "hooks" }
        expect { code = 0 }
      }
      ["bootstrap refuses a drifted vendored skill"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "repair" }
        expect { code = 0 }
      }
      ["a tracked tool-owned skill fails the check"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "tracked" }
        expect { code = 0 }
      }
      ["a tracked synced skill fails the check and names the path"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "synced-tracked" }
        expect { code = 0 }
      }
      ["an ignored synced cache keeps git status clean and passes the check"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "synced-ignored" }
        expect { code = 0 }
      }
      ["discovery counts are unchanged with the synced cache present"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "synced-discovery" }
        expect { code = 0 }
      }
      ["bootstrap renders, checks, backs up and repairs the MCP configs"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "mcp" }
        expect { code = 0 }
      }
      ["the secrets agent uses an absolute interpreter and retries loudly"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "secrets-agent" }
        expect { code = 0 }
      }
      ["the check names a missing, stale or absent secrets agent"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "plist-drift" }
        expect { code = 0 }
      }
      ["the ssh config routes GitHub through 1Password and the origin moves to SSH"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "ssh-agent" }
        expect { code = 0 }
      }
      ["a missing 1Password agent fails loudly and leaves origin alone"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "ssh-no-agent" }
        expect { code = 0 }
      }
      ["an existing github.com block is left alone"] {
        run = "check"
        env { ["BOOTSTRAP_CASE"] = "ssh-existing" }
        expect { code = 0 }
      }
    }
  }

  ["mcp-sync"] = new Step {
    check = "sh {{root}}/scripts/mcp-sync-test.sh"
    tests {
      ["a fresh render uses each harness env syntax and stays in sync"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "fresh" }
        expect { code = 0 }
      }
      ["the check names drift and the render repairs it"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "drift" }
        expect { code = 0 }
      }
      ["a retired server is removed and an unmanaged one survives"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "retired" }
        expect { code = 0 }
      }
      ["an absent harness config is left absent"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "absent" }
        expect { code = 0 }
      }
      ["keys and servers outside the registry survive"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "preserve" }
        expect { code = 0 }
      }
      ["a rewritten config is backed up and keeps its mode"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "backup" }
        expect { code = 0 }
      }
      ["the env mode reads the reference and sets only the name in output"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "env" }
        expect { code = 0 }
      }
      ["an unreadable reference fails loudly and sets nothing"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "env-fail" }
        expect { code = 0 }
      }
      ["the env check reports a missing launchd variable"] {
        run = "check"
        env { ["MCP_SYNC_CASE"] = "env-check" }
        expect { code = 0 }
      }
    }
  }

  ["block-issue"] = new Step {
    check = "sh {{root}}/skills/supervise/scripts/block-issue-test.sh"
    tests {
      ["posts one comment then the label"] {
        run = "check"
        env { ["BLOCK_ISSUE_CASE"] = "post" }
        expect { code = 0 }
      }
      ["keeps one comment on an already blocked issue"] {
        run = "check"
        env { ["BLOCK_ISSUE_CASE"] = "idempotent" }
        expect { code = 0 }
      }
      ["refuses a Blocker without an unblock step"] {
        run = "check"
        env { ["BLOCK_ISSUE_CASE"] = "missing" }
        expect { code = 0 }
      }
      ["refuses a repository traversal"] {
        run = "check"
        env { ["BLOCK_ISSUE_CASE"] = "invalid_repo" }
        expect { code = 0 }
      }
      ["stops before the label when the comment fails"] {
        run = "check"
        env { ["BLOCK_ISSUE_CASE"] = "failure" }
        expect { code = 0 }
      }
    }
  }

  ["file-promotion"] = new Step {
    check = "sh {{root}}/skills/supervise/scripts/file-promotion-test.sh"
    tests {
      ["names a Gate check"] {
        run = "check"
        env { ["FILE_PROMOTION_CASE"] = "gate_check" }
        expect { code = 0 }
      }
      ["states why no check is possible"] {
        run = "check"
        env { ["FILE_PROMOTION_CASE"] = "no_check" }
        expect { code = 0 }
      }
      ["refuses no check and no reason"] {
        run = "check"
        env { ["FILE_PROMOTION_CASE"] = "neither" }
        expect { code = 0 }
      }
      ["refuses both at once"] {
        run = "check"
        env { ["FILE_PROMOTION_CASE"] = "both" }
        expect { code = 0 }
      }
    }
  }

  ["process-receipt"] = new Step {
    check = "sh {{root}}/skills/supervise/scripts/process-receipt-test.sh"
    tests {
      ["a clean worktree prints none"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "clean" }
        expect { code = 0 }
      }
      ["reports a process whose cwd is in the worktree"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "cwd" }
        expect { code = 0 }
      }
      ["reports a process whose command line names the worktree"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "argv" }
        expect { code = 0 }
      }
      ["refuses without a baseline"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "no_baseline" }
        expect { code = 0 }
      }
      ["reports a simulator booted after the baseline"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "simulator" }
        expect { code = 0 }
      }
      ["reports a failed xcrun instead of none"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "simulator_unknown" }
        expect { code = 0 }
      }
      ["keeps the baseline in the git directory"] {
        run = "check"
        env { ["PROCESS_RECEIPT_CASE"] = "git_state" }
        expect { code = 0 }
      }
    }
  }

  ["evidence"] = new Step {
    check = "python3 {{root}}/skills/evidence/scripts/evidence-test"
    tests {
      ["evidence stays out of the repository"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "add_outside" }
        expect { code = 0 }
      }
      ["the repository and branch default to gh and the current branch"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "defaults" }
        expect { code = 0 }
      }
      ["add refuses a source inside the repository"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "add_source_inside" }
        expect { code = 0 }
      }
      ["add refuses a cache inside the repository"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "add_dest_inside" }
        expect { code = 0 }
      }
      ["staged evidence moves to the PR directory before the comment"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "stage_attach" }
        expect { code = 0 }
      }
      ["attach without a PR resolves it and posts from the PR directory"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "attach_resolves_pr" }
        expect { code = 0 }
      }
      ["a video over the limit is compressed and the comment is replaced"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "video" }
        expect { code = 0 }
      }
      ["a file over the limit fails before upload"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "oversize" }
        expect { code = 0 }
      }
      ["the receipt requires every field and one cost exception"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "receipt_rules" }
        expect { code = 0 }
      }
      ["more than 50 attachments is refused"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "too_many" }
        expect { code = 0 }
      }
      ["a gh failure names its cause"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "attach_gh_failure" }
        expect { code = 0 }
      }
      ["a failed replacement keeps one evidence comment"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "attach_rollback" }
        expect { code = 0 }
      }
      ["a staged directory left behind is reported"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "stage_leftover" }
        expect { code = 0 }
      }
      ["a cache permission failure is reported"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "cleanup_prune" }
        expect { code = 0 }
      }
      ["cleanup removes the worktree, branches and evidence"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "cleanup" }
        expect { code = 0 }
      }
      ["cleanup tolerates an already-deleted remote branch and a rerun"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "cleanup_idempotent" }
        expect { code = 0 }
      }
      ["cleanup refuses unmerged heads and dirty worktrees"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "cleanup_refusals" }
        expect { code = 0 }
      }
      ["the mise task runs the command"] {
        run = "check"
        env { ["EVIDENCE_CASE"] = "mise_task" }
        expect { code = 0 }
      }
    }
  }
}

amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

// comment-ban's help contains ${#array[@]}, which Tera reads as a comment tag; see https://keats.github.io/tera/docs/#raw-blocks.
local const commentBan = "{% raw %}" + read("scripts/comment-ban.sh").text + "{% endraw %}"
local const pinactScript = read("scripts/pinact.sh").text
local const pinactCmd = List("sh", "-c", "eval \"$PINACT_WRAPPER\"", "pinact", "run", "--verify-comment")

steps {
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["typos"] = Builtins.typos
  ["gitleaks"] = Builtins.gitleaks
  ["comment-ban"] = new Step {
    types = List("text")
    env { ["COMMENT_BAN"] = commentBan }
    check = new Command {
      argv = List("sh", "-c", "eval \"$COMMENT_BAN\"", "comment-ban", "{{files}}")
    }
    tests {
      ["rejects a TODO comment"] {
        run = "check"
        tmpdir = true
        write { ["todo.sh"] = read("tests/fixtures/todo.sh").text }
        files = List("todo.sh")
        expect { code = 1 }
      }
      ["rejects a semicolon TODO comment"] {
        run = "check"
        tmpdir = true
        write { ["todo.ini"] = read("tests/fixtures/todo.ini").text }
        files = List("todo.ini")
        expect { code = 1 }
      }
      ["rejects a block TODO comment"] {
        run = "check"
        tmpdir = true
        write { ["todo.css"] = read("tests/fixtures/todo.css").text }
        files = List("todo.css")
        expect { code = 1 }
      }
      ["accepts a clean file"] {
        run = "check"
        tmpdir = true
        write {
          ["clean.sh"] = read("tests/fixtures/clean.sh").text
          ["clean.pkl"] = read("tests/fixtures/clean.pkl").text
          ["clean.ini"] = read("tests/fixtures/clean.ini").text
        }
        files = List("clean.sh", "clean.pkl", "clean.ini")
        expect { code = 0 }
      }
      ["rejects commented-out code"] {
        run = "check"
        tmpdir = true
        write { ["commented-code.sh"] = read("tests/fixtures/commented-code.sh").text }
        files = List("commented-code.sh")
        expect { code = 1 }
      }
      ["rejects a commented-out key line"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# run: mise run check\n" }
        expect { code = 1 }
      }
      ["rejects a commented-out list item"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# - uses: actions/checkout@v4\n" }
        expect { code = 1 }
      }
      ["rejects a commented-out path command"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# ./build.sh --release\n" }
        expect { code = 1 }
      }
      ["rejects a nested gitignore TODO"] {
        run = "check"
        write { ["{{tmp}}/sub/.gitignore"] = "# TODO: nested\n" }
        expect { code = 1 }
      }
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["jactionlint"] = Builtins.jactionlint
  ["zizmor"] = Builtins.zizmor
  ["pinact"] = (Builtins.pinact) {
    env { ["PINACT_WRAPPER"] = pinactScript }
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = pinactCmd + List("--check", "{{files}}")
      }
      effect = "read"
    }
    check_diff = new Config.CommandSpec {
      command = new Config.Command {
        argv =
          List("hk", "util", "sarif-diff", "--") + pinactCmd + List(
            "--check",
            "--format",
            "sarif",
            "{{files}}",
          )
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command { argv = pinactCmd + List("{{files}}") }
      effect = "write"
    }
    tests = new Mapping<String, Config.StepTest> {
      ["uses GITHUB_TOKEN without asking gh"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\nexit 9\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\n[ \"${GITHUB_TOKEN:-}\" = token-from-env ]\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = "token-from-env"
        }
        expect { code = 0 }
      }
      ["reads the token from gh when GITHUB_TOKEN is empty"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\necho token-from-gh\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\n[ \"${GITHUB_TOKEN:-}\" = token-from-gh ]\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = ""
        }
        expect { code = 0 }
      }
      ["asks for gh auth login when gh is not signed in"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\nexit 1\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\nexit 0\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = ""
        }
        expect {
          code = 1
          stderr = "gh auth login"
        }
      }
      ["passes gh's own error through"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\necho 'gh: authentication required' >&2\nexit 1\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\nexit 0\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = ""
        }
        expect {
          code = 1
          stderr = "gh: authentication required"
        }
      }
    }
  }
  ["tombi"] = Builtins.tombi
  ["yamlfmt"] = Builtins.yamlfmt
}

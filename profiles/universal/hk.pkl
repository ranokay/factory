amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local const pinact = "{{root}}/profiles/universal/scripts/pinact.sh"

steps {
  ["editorconfig-checker"] = Builtins.editorconfig_checker
  ["typos"] = Builtins.typos
  ["gitleaks"] = Builtins.gitleaks
  ["comment-ban"] = new Step {
    types = List("text")
    exclude = List("profiles/universal/tests/fixtures/**")
    check = new Command {
      argv = List("{{root}}/profiles/universal/scripts/comment-ban.sh", "{{files}}")
    }
    tests {
      ["rejects a TODO comment"] {
        run = "check"
        files = List("{{root}}/profiles/universal/tests/fixtures/todo.sh")
        expect { code = 1 }
      }
      ["rejects a semicolon TODO comment"] {
        run = "check"
        files = List("{{root}}/profiles/universal/tests/fixtures/todo.ini")
        expect { code = 1 }
      }
      ["rejects a block TODO comment"] {
        run = "check"
        files = List("{{root}}/profiles/universal/tests/fixtures/todo.css")
        expect { code = 1 }
      }
      ["accepts a clean file"] {
        run = "check"
        files = List(
          "{{root}}/profiles/universal/tests/fixtures/clean.sh",
          "{{root}}/profiles/universal/tests/fixtures/clean.pkl",
          "{{root}}/profiles/universal/tests/fixtures/clean.ini",
        )
        expect { code = 0 }
      }
      ["rejects commented-out code"] {
        run = "check"
        files = List("{{root}}/profiles/universal/tests/fixtures/commented-code.sh")
        expect { code = 1 }
      }
      ["rejects a commented-out key line"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# run: mise run check\n" }
        expect { code = 1 }
      }
      ["rejects a commented-out list item"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# - uses: actions/checkout@v4\n" }
        expect { code = 1 }
      }
      ["rejects a commented-out path command"] {
        run = "check"
        write { ["{{tmp}}/comment.sh"] = "# ./build.sh --release\n" }
        expect { code = 1 }
      }
      ["rejects a nested gitignore TODO"] {
        run = "check"
        write { ["{{tmp}}/sub/.gitignore"] = "# TODO: nested\n" }
        expect { code = 1 }
      }
    }
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["jactionlint"] = Builtins.jactionlint
  ["zizmor"] = Builtins.zizmor
  ["pinact"] = (Builtins.pinact) {
    check = new Config.CommandSpec {
      command = new Config.Command {
        argv = List(
          pinact,
          "run",
          "--verify-comment",
          "--check",
          "{{files}}",
        )
      }
      effect = "read"
    }
    check_diff = new Config.CommandSpec {
      command = new Config.Command {
        argv = List(
          "hk",
          "util",
          "sarif-diff",
          "--",
          pinact,
          "run",
          "--verify-comment",
          "--check",
          "--format",
          "sarif",
          "{{files}}",
        )
      }
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = new Config.Command { argv = List(pinact, "run", "--verify-comment", "{{files}}") }
      effect = "write"
    }
    tests = new Mapping<String, Config.StepTest> {
      ["uses GITHUB_TOKEN without asking gh"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\nexit 9\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\n[ \"${GITHUB_TOKEN:-}\" = token-from-env ]\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = "token-from-env"
        }
        expect { code = 0 }
      }
      ["reads the token from gh when GITHUB_TOKEN is unset"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\necho token-from-gh\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\n[ \"${GITHUB_TOKEN:-}\" = token-from-gh ]\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = ""
        }
        expect { code = 0 }
      }
      ["asks for gh auth login when gh is not signed in"] {
        run = "check"
        write {
          ["{{tmp}}/bin/gh"] = "#!/bin/sh\nexit 1\n"
          ["{{tmp}}/bin/pinact"] = "#!/bin/sh\nexit 0\n"
          ["{{tmp}}/.github/workflows/test.yml"] = "name: test\n"
        }
        files = List("{{tmp}}/.github/workflows/test.yml")
        before = "chmod +x bin/gh bin/pinact"
        env {
          ["PATH"] = "bin:/usr/bin:/bin"
          ["GITHUB_TOKEN"] = ""
        }
        expect {
          code = 1
          stderr = "gh auth login"
        }
      }
    }
  }
  ["tombi"] = Builtins.tombi
  ["yamlfmt"] = Builtins.yamlfmt
}

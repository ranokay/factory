#!/usr/bin/env python3
import json
import os
import subprocess
import sys
from pathlib import Path

args = sys.argv[1:]
real = os.environ["REAL_GIT"]
with Path(os.environ["FAKE_GIT_LOG"]).open("a") as handle:
    handle.write(json.dumps(args) + "\n")

if "tag" in args and "--list" in args:
    reachable = os.environ.get("FAKE_TAG")
    unreachable = os.environ.get("FAKE_UNREACHABLE_TAG")
    if "--merged" in args:
        tags = [reachable] if reachable else []
    else:
        tags = [tag for tag in (unreachable, reachable) if tag]
    if tags:
        print("\n".join(tags))
        sys.exit(0)
    if os.environ.get("FAKE_NO_TAGS"):
        sys.exit(1)

if args and args[0] == "clone":
    options = args[1:]
    configs = []
    while options and options[0] == "-c":
        configs.append(options[1])
        options = options[2:]
    url, destination = options
    if os.environ.get("FAKE_REQUIRE_GH_CREDENTIALS") and configs != [
        "credential.https://github.com.helper=",
        "credential.https://github.com.helper=!gh auth git-credential",
    ]:
        message = "fatal: could not read Username for 'https://github.com': terminal prompts disabled"
        print(message, file=sys.stderr)
        sys.exit(128)
    Path(destination).mkdir(parents=True)
    subprocess.run(
        [real, "-c", "init.defaultBranch=main", "init", "-q", destination],
        check=True,
    )
    subprocess.run([real, "-C", destination, "remote", "add", "origin", url], check=True)
    for config in configs:
        key, value = config.split("=", 1)
        subprocess.run(
            [real, "-C", destination, "config", "--local", "--add", key, value],
            check=True,
        )
    sys.exit(0)

if "push" in args:
    if os.environ.get("FAKE_FAIL_PUSH"):
        sys.exit(1)
    location = args[args.index("-C") + 1] if "-C" in args else os.getcwd()
    subprocess.run(
        [real, "-C", location, "update-ref", "refs/remotes/origin/main", "HEAD"],
        check=False,
    )
    sys.exit(0)

os.execv(real, [real, *args])

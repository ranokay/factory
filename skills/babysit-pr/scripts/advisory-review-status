#!/usr/bin/env python3
"""Report whether each requested Advisory Reviewer has answered its request."""

import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from advisory_reviewers import (  # noqa: E402 -- the shared table ships beside this script
    REVIEWERS,
    activity_status,
    gh,
    is_reviewer,
    pages,
)

REPO = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
READ_ERRORS = (
    ValueError,
    KeyError,
    TypeError,
    AttributeError,
    OSError,
    subprocess.CalledProcessError,
    json.JSONDecodeError,
)


class Problem(Exception):
    pass


def item_timestamp(item):
    return item.get("updated_at") or item.get("created_at") or item.get("submitted_at") or ""


def covers(item, anchor, head=None):
    return item_timestamp(item) >= anchor or (head is not None and item.get("commit_id") == head)


def request_anchor(name, comments, timeline):
    spec = REVIEWERS[name]
    requests = []
    if spec["marker"]:
        requests += [item for item in comments if spec["marker"] in (item.get("body") or "")]
    if spec["timeline"]:
        requests += [
            item
            for item in timeline
            if item.get("event") == "review_requested"
            and is_reviewer((item.get("requested_reviewer") or {}).get("login"), name)
        ]
    stamps = []
    for item in requests:
        created = item.get("created_at")
        if not created:
            raise Problem(f"{name} request has no created_at")
        stamps.append(created)
    return max(stamps, default=None)


def reviewer_state(name, head, head_date, reviews, comments, inline_comments, timeline):
    bot_reviews = [item for item in reviews if is_reviewer((item.get("user") or {}).get("login"), name)]
    bot_comments = [item for item in comments if is_reviewer((item.get("user") or {}).get("login"), name)]
    bot_inline = [item for item in inline_comments if is_reviewer((item.get("user") or {}).get("login"), name)]
    anchor = request_anchor(name, comments, timeline)
    if anchor is None and not (bot_reviews or bot_comments or bot_inline):
        return {"name": name, "terminal": True, "reason": "not requested"}
    commit_head = head if anchor is None else None
    if anchor is None:
        anchor = head_date
    for item in [*bot_comments, *bot_inline, *bot_reviews]:
        if not covers(item, anchor, commit_head):
            continue
        status = activity_status(name, item)
        if commit_head is None and status not in ("activity", "placeholder"):
            created = item.get("created_at") or item.get("submitted_at") or ""
            if status == "review skipped" or not created or created < anchor:
                continue
        if status not in ("activity", "placeholder"):
            return {"name": name, "terminal": True, "reason": status}
    signals = []
    for item in bot_reviews:
        if covers(item, anchor, commit_head) and activity_status(name, item) == "activity":
            signals.append((item_timestamp(item), "review posted"))
    for item in bot_inline:
        created = item.get("created_at") or ""
        if commit_head is None and (not created or created < anchor):
            continue
        if covers(item, anchor, commit_head) and activity_status(name, item) == "activity":
            signals.append((item_timestamp(item), "inline comment"))
    for item in bot_comments:
        if not covers(item, anchor, commit_head) or activity_status(name, item) != "activity":
            continue
        created = item.get("created_at") or ""
        updated = item.get("updated_at") or ""
        markers = REVIEWERS[name]["summary_markers"]
        is_summary = bool(markers) and any(marker in (item.get("body") or "") for marker in markers)
        completion_markers = REVIEWERS[name]["completion_markers"]
        is_completion = any(marker in (item.get("body") or "").lower() for marker in completion_markers)
        if created >= anchor and is_summary:
            signals.append((created, "summary posted"))
        elif (
            created
            and updated > created
            and updated >= anchor
            and (created >= anchor or (REVIEWERS[name]["summary_edits_terminal"] and is_summary))
        ):
            signals.append((updated, "comment edit"))
        elif created >= anchor and is_completion:
            signals.append((created, "completion reply"))
    if signals:
        return {"name": name, "terminal": True, "reason": max(signals, key=lambda signal: signal[0])[1]}
    return {"name": name, "terminal": False, "reason": ""}


def report(repo, number):
    pr = gh("api", f"repos/{repo}/pulls/{number}")
    head = (pr.get("head") or {}).get("sha")
    if not head:
        raise Problem("the pull request has no head SHA")
    commit = gh("api", f"repos/{repo}/commits/{head}")
    head_date = ((commit.get("commit") or {}).get("committer") or {}).get("date")
    if not head_date:
        raise Problem(f"commit {head} has no committer date")
    reviews = [item for page in pages(f"repos/{repo}/pulls/{number}/reviews?per_page=100") for item in page]
    comments = [item for page in pages(f"repos/{repo}/issues/{number}/comments?per_page=100") for item in page]
    inline_comments = [item for page in pages(f"repos/{repo}/pulls/{number}/comments?per_page=100") for item in page]
    timeline = [item for page in pages(f"repos/{repo}/issues/{number}/timeline?per_page=100") for item in page]
    return [
        reviewer_state(name, head, head_date, reviews, comments, inline_comments, timeline) for name in REVIEWERS
    ]


def wait_for_terminal(check, timeout_seconds, interval_seconds, clock=time.monotonic, sleep=time.sleep):
    started = clock()
    while True:
        states = check()
        if all(state["terminal"] for state in states):
            return states, False
        remaining = timeout_seconds - (clock() - started)
        if remaining <= 0:
            return states, True
        sleep(min(interval_seconds, remaining))


def minutes(seconds):
    return f"{seconds / 60:g}m"


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repo")
    parser.add_argument("pr", type=int)
    parser.add_argument("--wait", action="store_true", help="poll until every reviewer is terminal or the timeout expires")
    parser.add_argument("--timeout-minutes", type=float, default=20.0, help="the bounded wait, 20 minutes by default")
    parser.add_argument("--interval-seconds", type=float, default=30.0, help="seconds between status reads")
    args = parser.parse_args(argv)
    try:
        if not REPO.match(args.repo) or args.pr < 1:
            raise Problem("usage: advisory-review-status OWNER/REPO PR")
        if args.timeout_minutes < 0:
            raise Problem("--timeout-minutes cannot be negative")
        if args.interval_seconds <= 0:
            raise Problem("--interval-seconds must be positive")
        timeout_seconds = args.timeout_minutes * 60
        if args.wait:
            states, timed_out = wait_for_terminal(
                lambda: report(args.repo, args.pr), timeout_seconds, args.interval_seconds
            )
        else:
            states = report(args.repo, args.pr)
            timed_out = False
        for state in states:
            label = "terminal" if state["terminal"] else "pending"
            reason = f" ({state['reason']})" if state["reason"] else ""
            print(f"{state['name']}: {label}{reason}")
        pending = [state["name"] for state in states if not state["terminal"]]
        if timed_out:
            print(f"timed out after {minutes(timeout_seconds)}: {', '.join(pending)}")
            return 3
        if pending:
            print(f"pending: {', '.join(pending)}")
            return 1
        print("all advisory reviewers terminal")
        return 0
    except READ_ERRORS + (Problem,) as error:
        print(f"advisory-review-status: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())

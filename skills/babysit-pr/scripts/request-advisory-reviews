#!/usr/bin/env python3
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "merge-pr" / "scripts"))
from merge_guard import is_outside  # noqa: E402 -- the Merge Guard lives with the merge command


def gh(*args):
    result = subprocess.run(["gh", *args], check=True, capture_output=True, text=True)
    return json.loads(result.stdout) if result.stdout.strip() else None


def pages(endpoint):
    return gh("api", "--paginate", "--slurp", endpoint)


def main():
    if len(sys.argv) != 3 or "/" not in sys.argv[1] or not sys.argv[2].isdigit():
        raise ValueError("usage: request-advisory-reviews OWNER/REPO PR")
    repo, number = sys.argv[1:]
    prefix = f"repos/{repo}"
    pr = gh("api", f"{prefix}/pulls/{number}")
    head = pr["head"]["sha"]
    checks = [check for page in pages(f"{prefix}/commits/{head}/check-runs?per_page=100") for check in page["check_runs"]]
    runs = [run for page in pages(f"{prefix}/actions/runs?event=pull_request&head_sha={head}&per_page=100") for run in page["workflow_runs"]]
    candidates = [r for r in runs if r["head_sha"] == head and r.get("display_title") == f"AI Review PR {number}"]
    latest = max(candidates, key=lambda r: (r.get("run_attempt", 1), r["id"])) if candidates else None
    matching = [c for c in checks if latest and f"/actions/runs/{latest['id']}/" in (c.get("details_url") or "")]
    if not latest or latest["status"] != "completed" or not matching or any(c["status"] != "completed" for c in matching):
        raise ValueError("AI Review has not completed on the PR head")
    conclusions = ", ".join(sorted({str(c.get("conclusion")) for c in matching}))
    print(f"AI Review completed: workflow={latest.get('conclusion')}, checks={conclusions}")
    reviews = [item for page in pages(f"{prefix}/pulls/{number}/reviews?per_page=100") for item in page]
    outside = is_outside(pr, repo)
    owner_reviews = [r for r in reviews if r["user"]["login"].lower() == "ranokay" and r["state"] in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED")]
    approved = bool(owner_reviews) and owner_reviews[-1]["state"] == "APPROVED" and owner_reviews[-1].get("commit_id") == head
    if outside and not approved:
        raise ValueError("Outside Contributor PR requires an APPROVED review by ranokay")
    comments = [item for page in pages(f"{prefix}/issues/{number}/comments?per_page=100") for item in page]
    comments += [item for page in pages(f"{prefix}/pulls/{number}/comments?per_page=100") for item in page]
    timeline = [item for page in pages(f"{prefix}/issues/{number}/timeline?per_page=100") for item in page]
    requested = any(e.get("event") == "review_requested" and "copilot" in (e.get("requested_reviewer") or {}).get("login", "").lower() for e in timeline)
    reviewed = any("copilot" in r["user"]["login"].lower() for r in reviews)
    if not requested and not reviewed:
        subprocess.run(["gh", "pr", "edit", number, "--repo", repo, "--add-reviewer", "@copilot"], check=True)
    for bot, command, reviewers in (("coderabbit", "@coderabbitai review", {"coderabbitai[bot]"}), ("greptile", "@greptileai", {"greptile-apps[bot]", "greptile[bot]"})):
        marker = f"<!-- factory:advisory-review:{bot} -->"
        marked = any(marker in (comment.get("body") or "") for comment in comments)
        has_activity = any((item.get("user") or {}).get("login", "").lower() in reviewers for item in [*reviews, *comments])
        if not marked and not has_activity:
            subprocess.run(["gh", "pr", "comment", number, "--repo", repo, "--body", f"{command}\n\n{marker}"], check=True)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, subprocess.CalledProcessError, KeyError) as error:
        print(f"request-advisory-reviews: {error}", file=sys.stderr)
        sys.exit(1)

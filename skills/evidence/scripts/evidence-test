@case
def case_summary_limit(work):
    repo, _ = make_repo(work)
    ten = "\n".join(
        f"`cmd {index}` \u2014 exit 0 \u2014 https://github.com/a/one/actions/runs/{index}" for index in range(10)
    )
    ok(tool(work, repo, receipt_args(pr="7", summary=ten)))
    ok(tool(work, repo, receipt_args(pr="9", summary=ten + "\n")))
    result = tool(work, repo, receipt_args(pr="8", summary=ten + "\nlast"))
    refused(result, "10 lines")
    expect("exit code" in result.stderr, result.stderr)
    expect("CI run" in result.stderr, result.stderr)
    expect(not (work / "cache" / "a" / "one" / "8" / "receipt.json").exists(), "an over-long summary was stored")


@case
def case_no_attachments(work):
    repo, _ = make_repo(work)
    summary = (
        "`mise run check` \u2014 exit 0 \u2014 https://github.com/a/one/actions/runs/1\n"
        "The CLI change has no visual surface."
    )
    ok(tool(work, repo, receipt_args(pr="7", summary=summary)))
    target = work / "cache" / "a" / "one" / "7"
    (target / "notes.txt").write_text("command output\n")
    notes = work / "notes.txt"
    notes.write_text("command output\n")
    refused(
        tool(work, repo, ["add", str(notes), "--caption", "Log output", "--repo", "a/one", "--pr", "7"]),
        "not an image or video",
    )
    dry = ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"]))
    expect("--attach" not in dry, dry)
    body = (target / "body.md").read_text()
    expect("### Attachments" not in body, body)
    expect("notes.txt" not in body, body)
    expect("![" not in body, body)
    expect(body.rstrip().endswith("</details>"), body)
    expect(summary.splitlines()[0] in body, body)
    expect("<details>\n<summary>Run receipt</summary>" in body, body)
    expect("- Worker model:" in body, body)
    expect(len(body.rstrip().splitlines()) < 25, f"{len(body.rstrip().splitlines())} lines:\n{body}")
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"]))
    recorded = comment(work, "101")
    expect(recorded["attachments"] == [], recorded)


@case
def case_caption_merge(work):
    repo, _ = make_repo(work)
    wt = make_worktree(repo, work)
    make_pr(work, git(wt, "rev-parse", "HEAD"), "feat/thing")
    ok(
        tool(
            work,
            wt,
            ["add", str(make_image(work / "existing.png")), "--caption", "Existing state", "--repo", "a/one", "--pr", "7"],
        )
    )
    ok(tool(work, wt, ["add", str(make_image(work / "a-staged.png")), "--caption", "Staged state", "--repo", "a/one"]))
    ok(tool(work, wt, receipt_args(pr="7")))
    ok(tool(work, wt, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"]))
    target = work / "cache" / "a" / "one" / "7"
    captions = json.loads((target / "captions.json").read_text())
    expect(captions == {"existing.png": "Existing state", "a-staged.png": "Staged state"}, f"captions were {captions}")
    body = (target / "body.md").read_text()
    expect("Existing state" in body and "Staged state" in body, body)
    ok(tool(work, wt, ["attach", "--repo", "a/one", "--pr", "7"]))
    recorded = comment(work, "101")
    expect(len(recorded["attachments"]) == 2, f"attachments were {recorded['attachments']}")


@case
def case_legacy_receipt_over_ten_lines(work):
    repo, _ = make_repo(work)
    target = work / "cache" / "a" / "one" / "7"
    target.mkdir(parents=True)
    summary = "\n".join(f"line {index}" for index in range(11))
    (target / "receipt.json").write_text(
        json.dumps(
            {
                "model": "m",
                "variant": "max",
                "fallback": "no",
                "attempts": 1,
                "cost": "1k tokens",
                "gates": ["`mise run check` \u2014 exit 0"],
                "summary": summary,
            }
        )
    )
    out = ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"]))
    expect("dry run: no comment posted" in out, out)
    body = (target / "body.md").read_text()
    expect("line 0" in body and "line 10" in body, body)


def main():
    names = [CASE] if CASE != "all" else list(CASES)
    failures = []
    for name in names:
        work = new_work()
        failed = False
        try:
            CASES[name](work)
            print(f"ok: {name}")
        except Failure as error:
            failed = True
            failures.append(f"{name}: {error}\nfixture: {work}")
        finally:
            if not failed:
                shutil.rmtree(work, ignore_errors=True)
    if failures:
        print("\n\n".join(failures), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

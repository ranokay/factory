@case
def case_attachment_limit(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    image = make_image(work / "shot.png")
    files = []
    captions = []
    for index in range(5):
        path = work / f"shot-{index}.png"
        shutil.copy2(image, path)
        files.append(str(path))
        captions += ["--caption", f"State {index}"]
    ok(tool(work, repo, ["add", *files, "--repo", "a/one", "--pr", "7", *captions]))
    target = work / "cache" / "a" / "one" / "7"
    expect(len([item for item in target.iterdir() if item.suffix == ".png"]) == 5, "expected five stored attachments")
    sixth = work / "shot-5.png"
    shutil.copy2(image, sixth)
    result = tool(work, repo, ["add", str(sixth), "--caption", "Sixth state", "--repo", "a/one", "--pr", "7"])
    refused(result, "drop or merge")
    expect("at most 5" in result.stderr, result.stderr)
    expect(not (target / "shot-5.png").exists(), "the sixth attachment was stored")
    stored_captions = json.loads((target / "captions.json").read_text())
    expect(
        stored_captions == {f"shot-{index}.png": f"State {index}" for index in range(5)},
        f"captions were {stored_captions}",
    )
    shutil.copy2(image, target / "manual.png")
    stored_captions = json.loads((target / "captions.json").read_text())
    stored_captions["manual.png"] = "Manual state"
    (target / "captions.json").write_text(json.dumps(stored_captions))
    result = tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"])
    refused(result, "drop or merge")
    over = tool(
        work,
        repo,
        ["add", *files, str(sixth), "--repo", "a/one", "--pr", "8", *captions, "--caption", "Sixth state"],
    )
    refused(over, "at most 5")
    expect(not (work / "cache" / "a" / "one" / "8").exists(), "an over-cap add wrote evidence")



@case
def case_attach_rollback(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    ok(tool(work, repo, ["add", str(make_image(work / "shot.png")), "--caption", "Login banner", "--repo", "a/one", "--pr", "7"]))
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"]))
    (work / "gh" / "fail_delete").write_text("1")
    result = tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"])
    refused(result, "previous comment 101 remains")
    expect("new comment was withdrawn" in result.stderr, result.stderr)
    ids = (work / "gh" / "ids").read_text().split()
    expect(ids == ["101"], f"expected the previous comment to remain, found {ids}")


@case
def case_stage_leftover(work):
    repo, _ = make_repo(work)
    wt = make_worktree(repo, work)
    make_pr(work, git(wt, "rev-parse", "HEAD"), "feat/thing")
    ok(tool(work, wt, ["add", str(make_image(work / "shot.png")), "--caption", "Login banner", "--repo", "a/one"]))
    ok(tool(work, wt, receipt_args(pr=None)))
    stage = work / "cache" / "a" / "one" / "branch" / "feat-thing"
    (stage / "nested").mkdir()
    (stage / "nested" / "keep.txt").write_text("keep")
    out = ok(tool(work, wt, ["attach", "--repo", "a/one", "--pr", "7"]))
    expect("left" in out and "in place" in out, out)
    expect((stage / "nested" / "keep.txt").is_file(), "the nested stage content was lost")
    expect((work / "cache" / "a" / "one" / "7" / "shot.png").is_file(), "the staged image did not move")


@case
def case_cleanup_prune(work):
    repo, origin = make_repo(work)
    wt = make_worktree(repo, work)
    make_pr(work, git(wt, "rev-parse", "HEAD"), "feat/thing")
    seed_evidence(work, "7", "feat-thing")
    owner = work / "cache" / "a"
    owner.chmod(0o500)
    try:
        result = tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"])
    finally:
        owner.chmod(0o700)
    refused(result, "cannot remove")
    expect(not wt.exists(), "the worktree was not removed before the prune failure")


@case
def case_attach_resolves_pr(work):
    repo, _ = make_repo(work)
    wt = make_worktree(repo, work)
    make_pr(work, git(wt, "rev-parse", "HEAD"), "feat/thing")
    (work / "gh" / "pr_number").write_text("7")
    ok(tool(work, wt, ["add", str(make_image(work / "shot.png")), "--caption", "Login banner", "--repo", "a/one"]))
    ok(tool(work, wt, receipt_args(pr=None)))
    stage = work / "cache" / "a" / "one" / "branch" / "feat-thing"
    out = ok(tool(work, wt, ["attach", "--repo", "a/one"]))
    target = work / "cache" / "a" / "one" / "7"
    expect((target / "shot.png").is_file(), "the staged file did not move into the PR directory")
    expect((target / "body.md").is_file(), "the body was not written to the PR directory")
    expect(not stage.exists(), "the staging directory remains")
    expect("https://github.com/a/one/pull/7#issuecomment-" in out, out)
    recorded = comment(work, "101")
    expect(recorded["attachments"] == [str(target / "shot.png")], str(recorded))


@case
def case_cleanup(work):
    repo, origin = make_repo(work)
    wt = make_worktree(repo, work)
    head = git(wt, "rev-parse", "HEAD")
    make_pr(work, head, "feat/thing")
    seed_evidence(work, "7", "feat-thing")
    (wt / "node_modules").mkdir()
    (wt / "node_modules" / "dep.js").write_text("x")
    (wt / ".env.local").write_text("PRIVATE=1\n")
    expect(git(wt, "status", "--porcelain") == "", "ignored files made the worktree dirty")
    from_worktree = tool(work, wt, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"])
    refused(from_worktree, "main checkout")
    expect(wt.is_dir(), "the refused run removed the worktree")
    (work / "gh" / "open_prs").write_text(json.dumps([{"number": 9, "headRepositoryOwner": {"login": "contributor"}}]))
    git(wt, "switch", "-c", "other")
    ok(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]))
    expect(not wt.exists(), "the worktree remains")
    expect(not (wt / "node_modules").exists(), "the ignored build directory remains")
    expect(not (wt / ".env.local").exists(), "the ignored file remains")
    expect(git(repo, "branch", "--list", "feat/thing") == "", "the local branch remains")
    expect("feat/thing" not in git(origin, "for-each-ref", "--format=%(refname)", "refs/heads"), "the remote branch remains")
    expect(not (work / "cache" / "a").exists(), "the evidence directory remains")


@case
def case_cleanup_idempotent(work):
    repo, origin = make_repo(work)
    wt = make_worktree(repo, work)
    head = git(wt, "rev-parse", "HEAD")
    make_pr(work, head, "feat/thing")
    seed_evidence(work, "7", "feat-thing")
    git(repo, "push", "origin", "--delete", "feat/thing")
    ok(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]))
    expect(not wt.exists(), "the worktree remains")
    expect(git(repo, "branch", "--list", "feat/thing") == "", "the local branch remains")
    expect(not (work / "cache" / "a").exists(), "the evidence directory remains")
    again = ok(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]))
    expect(again.count("already gone") >= 3, again)


@case
def case_cleanup_refusals(work):
    repo, origin = make_repo(work)
    wt = make_worktree(repo, work)
    head = git(wt, "rev-parse", "HEAD")
    make_pr(work, head, "feat/thing")
    seed_evidence(work, "7", "feat-thing")

    def intact():
        expect(wt.is_dir(), "the worktree was removed by a refused run")
        expect("feat/thing" in git(repo, "branch", "--list", "feat/thing"), "the local branch was removed by a refused run")
        expect(
            "feat/thing" in git(origin, "for-each-ref", "--format=%(refname)", "refs/heads"),
            "the remote branch was removed by a refused run",
        )
        expect((work / "cache" / "a" / "one" / "7" / "shot.png").is_file(), "the evidence was removed by a refused run")

    (wt / "notes.txt").write_text("draft\n")
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "uncommitted changes")
    intact()
    (wt / "notes.txt").unlink()
    (wt / "change.txt").write_text("modified\n")
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "uncommitted changes")
    intact()
    git(wt, "checkout", "--", "change.txt")
    (work / "gh" / "open_prs").write_text(json.dumps([{"number": 8, "headRepositoryOwner": {"login": "a"}}]))
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "open PR 8")
    intact()
    (work / "gh" / "open_prs").write_text("not json")
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "could not read the open PRs")
    intact()
    (work / "gh" / "open_prs").write_text(json.dumps([{}]))
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "without a number")
    intact()
    (work / "gh" / "open_prs").unlink()
    (wt / "change.txt").write_text("second\n")
    git(wt, "add", "change.txt")
    git(wt, "commit", "-q", "-m", "second")
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "were not merged")
    intact()
    make_pr(work, head, "feat/thing", state="OPEN")
    refused(tool(work, repo, ["cleanup", "--worktree", str(wt), "--repo", "a/one", "--pr", "7"]), "not MERGED")
    intact()


@case
def case_mise_task(work):
    env = environment(work)
    result = subprocess.run(
        ["mise", "--cd", str(ROOT), "run", "evidence", "path", "--repo", "a/one", "--pr", "7"],
        cwd=work,
        env=env,
        capture_output=True,
        text=True,
    )
    printed = ok(result).strip()
    expected = work / "cache" / "a" / "one" / "7"
    expect(printed == str(expected), f"mise run evidence path printed {printed}")


@case
def case_add_caption(work):
    repo, _ = make_repo(work)
    image = make_image(work / "shot.png")
    missing = tool(work, repo, ["add", str(image), "--repo", "a/one", "--pr", "7"])
    refused(missing, "one --caption per file")
    expect("visible behaviour" in missing.stderr, missing.stderr)
    expect(not (work / "cache" / "a" / "one" / "7").exists(), "evidence was written without a caption")
    second = make_image(work / "second.png")
    mismatch = tool(
        work, repo, ["add", str(image), str(second), "--caption", "One", "--repo", "a/one", "--pr", "7"]
    )
    refused(mismatch, "2 files and 1 caption")
    multiline = tool(
        work, repo, ["add", str(image), "--caption", "first\nsecond", "--repo", "a/one", "--pr", "7"]
    )
    refused(multiline, "must be one line")
    blank = tool(work, repo, ["add", str(image), "--caption", "   ", "--repo", "a/one", "--pr", "7"])
    refused(blank, "is empty")
    duplicate = tool(
        work,
        repo,
        [
            "add",
            str(make_image(work / "a" / "shot.png")),
            str(make_image(work / "b" / "shot.png")),
            "--caption",
            "One",
            "--caption",
            "Two",
            "--repo",
            "a/one",
            "--pr",
            "7",
        ],
    )
    refused(duplicate, "more than one file")
    ok(
        tool(
            work,
            repo,
            ["add", str(image), str(second), "--caption", "Login banner", "--caption", "Saved toast", "--repo", "a/one", "--pr", "7"],
        )
    )
    captions = json.loads((work / "cache" / "a" / "one" / "7" / "captions.json").read_text())
    expect(captions == {"shot.png": "Login banner", "second.png": "Saved toast"}, f"captions were {captions}")


@case
def case_caption_escape(work):
    repo, _ = make_repo(work)
    image = make_image(work / "shot.png")
    caption = '- Banner <b>shows</b> [ok] & "quoted" \\ path'
    ok(tool(work, repo, ["add", str(image), "--caption", caption, "--repo", "a/one", "--pr", "7"]))
    ok(
        tool(
            work,
            repo,
            ["add", str(make_image(work / "second.png")), "--caption", "1. first", "--repo", "a/one", "--pr", "7"],
        )
    )
    ok(
        tool(
            work,
            repo,
            receipt_args(
                pr="7",
                model="m</details>",
                summary="`mise run check` \u2014 exit 0\n<b>proof</b>",
                gates=("`mise run check` \u2014 exit 0 </details>",),
            ),
        )
    )
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"]))
    body = (work / "cache" / "a" / "one" / "7" / "body.md").read_text()
    expect('\\- Banner &lt;b&gt;shows&lt;/b&gt; \\[ok\\] &amp; &quot;quoted&quot; \\\\ path' in body, body)
    expect(caption not in body, body)
    expect("&lt;b&gt;proof&lt;/b&gt;" in body, body)
    expect("m&lt;/details&gt;" in body, body)
    expect("1\\. first" in body, body)
    expect("&lt;/details&gt;" in body, body)
    expect("<b>" not in body, body)



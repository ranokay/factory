    expect((target / "shot.png").is_file(), "the in-place image was deleted")
    captions = json.loads((target / "captions.json").read_text())
    expect(captions == {"shot.png": "Large state"}, f"captions were {captions}")


@case
def case_stage_attach(work):
    repo, _ = make_repo(work)
    wt = make_worktree(repo, work)
    make_pr(work, git(wt, "rev-parse", "HEAD"), "feat/thing")
    image = make_image(work / "shot.png")
    ok(tool(work, wt, ["add", str(image), "--caption", "Login form shows the error banner", "--repo", "a/one"]))
    stage = work / "cache" / "a" / "one" / "branch" / "feat-thing"
    expect((stage / "shot.png").is_file(), "the image was not staged under the branch")
    ok(tool(work, wt, receipt_args(pr=None)))
    expect((stage / "receipt.json").is_file(), "the receipt was not staged under the branch")
    dry = ok(tool(work, wt, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"]))
    expect("gh pr comment 7" in dry, f"dry run did not print the command: {dry}")
    expect((stage / "shot.png").is_file(), "the dry run moved the staged file")
    if (work / "gh" / "log").exists():
        expect('"pr", "comment"' not in (work / "gh" / "log").read_text(), "the dry run posted a comment")
    expect((work / "cache" / "a" / "one" / "7" / "body.md").is_file(), "the dry run wrote no body")
    ok(tool(work, wt, ["attach", "--repo", "a/one", "--pr", "7"]))
    target = work / "cache" / "a" / "one" / "7" / "shot.png"
    expect(target.is_file(), "the staged file was not moved into the PR directory")
    expect(not stage.exists(), "the branch staging directory was left behind")
    recorded = comment(work, "101")
    expect(recorded["attachments"] == [str(target)], f"attachments were {recorded['attachments']}")
    body = Path(recorded["body"]).read_text()
    expect("![shot.png](./shot.png)\n\nLogin form shows the error banner" in body, body)
    expect("<details>\n<summary>Run receipt</summary>" in body, body)
    expect(body.rstrip().endswith("</details>"), body)


@case
def case_video(work):
    repo, _ = make_repo(work)
    source = make_video(work / "demo.mp4")
    expect(source.stat().st_size > 1000000, f"the fixture video is only {source.stat().st_size} bytes")
    added = ok(
        tool(
            work,
            repo,
            ["add", str(source), "--caption", "The flow records and the clip compresses", "--repo", "a/one", "--pr", "7"],
            env={"EVIDENCE_MAX_BYTES": "1000000"},
        )
    )
    expect("compressed demo.mp4" in added, added)
    target = work / "cache" / "a" / "one" / "7" / "demo-compressed.mp4"
    expect(target.is_file(), f"{target} was not written")
    expect(target.stat().st_size <= 1000000, f"the compressed video is {target.stat().st_size} bytes")
    expect(not (work / "cache" / "a" / "one" / "7" / "demo.mp4").exists(), "the oversize original remains")
    ok(
        tool(
            work,
            repo,
            receipt_args(
                pr="7",
                model="opencode-go/deepseek-v4.1-flash",
                cost="12k tokens",
                gates=("`mise run check` \u2014 exit 0",),
                summary="The evidence tool compressed the clip and posted the comment.",
            ),
            env={"EVIDENCE_MAX_BYTES": "1000000"},
        )
    )
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"], env={"EVIDENCE_MAX_BYTES": "1000000"}))
    recorded = comment(work, "101")
    expect(recorded["attachments"] == [str(target)], f"attachments were {recorded['attachments']}")
    body = Path(recorded["body"]).read_text()
    expect("![demo-compressed.mp4](./demo-compressed.mp4)\n\nThe flow records and the clip compresses" in body, body)
    expect("- Worker model: `opencode-go/deepseek-v4.1-flash` (variant `max`)" in body, body)
    expect("- Fallback used: no" in body, body)
    expect("- Attempts: 1" in body, body)
    expect("- Token cost: 12k tokens" in body, body)
    expect("- `mise run check` \u2014 exit 0" in body, body)
    expect(body.rstrip().endswith("</details>"), body)
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"], env={"EVIDENCE_MAX_BYTES": "1000000"}))
    ids = (work / "gh" / "ids").read_text().split()
    expect(ids == ["102"], f"expected one comment, found {ids}")
    log = (work / "gh" / "log").read_text()
    expect(log.count('"pr", "comment"') == 2, log)
    expect('"--method", "DELETE"' in log, log)


@case
def case_attach_video_compress(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    target = work / "cache" / "a" / "one" / "7"
    source = make_video(work / "demo.mp4")
    expect(source.stat().st_size > 1000000, f"the fixture video is only {source.stat().st_size} bytes")
    shutil.copy2(source, target / "demo.mp4")
    (target / "captions.json").write_text(json.dumps({"demo.mp4": "The flow records end to end"}))
    dry = ok(
        tool(
            work,
            repo,
            ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"],
            env={"EVIDENCE_MAX_BYTES": "1000000"},
        )
    )
    compressed = target / "demo-compressed.mp4"
    expect(compressed.is_file(), "the video was not compressed")
    expect(not (target / "demo.mp4").exists(), "the original video remains")
    expect(f"--attach {compressed}" in dry, dry)
    expect(f"--attach {target / 'demo.mp4'}" not in dry, dry)
    body = (target / "body.md").read_text()
    expect("![demo-compressed.mp4](./demo-compressed.mp4)\n\nThe flow records end to end" in body, body)
    captions = json.loads((target / "captions.json").read_text())
    expect(captions == {"demo-compressed.mp4": "The flow records end to end"}, f"captions were {captions}")
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"], env={"EVIDENCE_MAX_BYTES": "1000000"}))
    recorded = comment(work, "101")
    expect(recorded["attachments"] == [str(compressed)], f"attachments were {recorded['attachments']}")


@case
def case_attach_video_collision(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    target = work / "cache" / "a" / "one" / "7"
    big = make_video(work / "demo.mp4", seconds=3)
    small = make_video(work / "demo-compressed.mp4", seconds=1)
    limit = 1200000
    expect(big.stat().st_size > limit, f"the big fixture video is only {big.stat().st_size} bytes")
    expect(small.stat().st_size <= limit, f"the small fixture video is {small.stat().st_size} bytes")
    shutil.copy2(big, target / "demo.mp4")
    shutil.copy2(small, target / "demo-compressed.mp4")
    (target / "captions.json").write_text(json.dumps({"demo.mp4": "New flow", "demo-compressed.mp4": "Old flow"}))
    dry = ok(
        tool(
            work,
            repo,
            ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"],
            env={"EVIDENCE_MAX_BYTES": str(limit)},
        )
    )
    compressed = target / "demo-compressed-2.mp4"
    expect(compressed.is_file(), "the compressed video did not get a unique name")
    expect((target / "demo-compressed.mp4").is_file(), "the existing compressed video was overwritten")
    expect(str(compressed) in dry, dry)
    expect(not (target / "demo.mp4").exists(), "the original video remains")
    body = (target / "body.md").read_text()
    expect("![demo-compressed.mp4](./demo-compressed.mp4)" in body, body)
    expect("![demo-compressed-2.mp4](./demo-compressed-2.mp4)" in body, body)
    expect("Old flow" in body and "New flow" in body, body)
    captions = json.loads((target / "captions.json").read_text())
    expect(
        captions == {"demo-compressed-2.mp4": "New flow", "demo-compressed.mp4": "Old flow"},
        f"captions were {captions}",
    )
    ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"], env={"EVIDENCE_MAX_BYTES": str(limit)}))
    recorded = comment(work, "101")
    expected = sorted([str(target / "demo-compressed.mp4"), str(compressed)])
    expect(sorted(recorded["attachments"]) == expected, f"attachments were {recorded['attachments']}")


@case
def case_attach_rekey_survives_failure(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    target = work / "cache" / "a" / "one" / "7"
    shutil.copy2(make_video(work / "a.mp4", seconds=3), target / "a.mp4")
    image = make_image(target / "z.png", size="3840x2160")
    expect(image.stat().st_size > 500000, f"the fixture image is only {image.stat().st_size} bytes")
    (target / "captions.json").write_text(json.dumps({"a.mp4": "The flow records"}))
    result = tool(
        work,
        repo,
        ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"],
        env={"EVIDENCE_MAX_BYTES": "500000"},
    )
    refused(result, "attachment limit")
    compressed = target / "a-compressed.mp4"
    expect(compressed.is_file(), "the video was not compressed")
    expect(not (target / "a.mp4").exists(), "the original video remains")
    captions = json.loads((target / "captions.json").read_text())
    expect(captions == {"a-compressed.mp4": "The flow records"}, f"captions were {captions}")
    result = tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7"], env={"EVIDENCE_MAX_BYTES": "500000"})
    refused(result, "attachment limit")
    expect(not (work / "gh" / "comment-101.json").exists(), "a failed attach posted a comment")


@case
def case_cap_after_compression(work):
    repo, _ = make_repo(work)
    ok(tool(work, repo, receipt_args(pr="7")))
    target = work / "cache" / "a" / "one" / "7"
    target.mkdir(parents=True, exist_ok=True)
    image = make_image(work / "shot.png")
    captions = {}
    for index in range(4):
        path = target / f"shot-{index}.png"
        shutil.copy2(image, path)
        captions[path.name] = f"State {index}"
    video = make_video(work / "demo.mp4", seconds=3)
    expect(video.stat().st_size > 1000000, f"the fixture video is only {video.stat().st_size} bytes")
    shutil.copy2(video, target / "demo.mp4")
    captions["demo.mp4"] = "Flow recording"
    (target / "captions.json").write_text(json.dumps(captions))
    dry = ok(tool(work, repo, ["attach", "--repo", "a/one", "--pr", "7", "--dry-run"], env={"EVIDENCE_MAX_BYTES": "1000000"}))
    expect("--attach " in dry, dry)
    expect(dry.count("--attach ") == 5, dry)
    body = (target / "body.md").read_text()
    expect(body.count("![") == 5, body)
    expect(not (target / "demo.mp4").exists(), "the original video remains")
    expect((target / "demo-compressed.mp4").is_file(), "the video was not compressed")



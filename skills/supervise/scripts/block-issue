#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: block-issue <owner>/<repo> <issue> --reason <text> --unblock <text>
                    [--evidence <text>]... [--finding <text>]...

Adds the blocked label and posts the Run's one Blocker comment. The comment
starts with a marker so blocker-notify.yml can find it. The comment is posted
before the label, so the labeled event always sees it.

The comment mentions @ranokay, states the unblock step, and carries the last
evidence and the open findings. If the issue is already blocked with a Blocker
comment, the script prints that comment's URL and changes nothing.
EOF
}

marker='<!-- factory:blocker -->'

fail() {
  printf 'block-issue: %s\n' "$1" >&2
  exit 2
}

script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd)
# shellcheck source=skills/supervise/scripts/valid-repo.sh
# shellcheck disable=SC1091
. "$script_dir/valid-repo.sh"

[ "$#" -ge 2 ] || {
  usage >&2
  exit 2
}
repo=$1
issue=$2
shift 2
valid_repo "$repo" || fail "invalid repository $repo"
case $issue in
'' | *[!0-9]*) fail "issue must be a number" ;;
esac

reason=
unblock=
evidence=
findings=
while [ "$#" -gt 0 ]; do
  case $1 in
  --reason)
    [ "$#" -ge 2 ] || fail "missing value for --reason"
    reason=$2
    shift 2
    ;;
  --unblock)
    [ "$#" -ge 2 ] || fail "missing value for --unblock"
    unblock=$2
    shift 2
    ;;
  --evidence)
    [ "$#" -ge 2 ] || fail "missing value for --evidence"
    evidence="$evidence${evidence:+, }$2"
    shift 2
    ;;
  --finding)
    [ "$#" -ge 2 ] || fail "missing value for --finding"
    findings="$findings${findings:+; }$2"
    shift 2
    ;;
  *)
    fail "unknown argument $1"
    ;;
  esac
done
[ -n "$reason" ] || fail "missing --reason"
[ -n "$unblock" ] || fail "missing --unblock"

labels=$(gh issue view "$issue" -R "$repo" --json labels --jq '.labels[].name')
if printf '%s\n' "$labels" | grep -qx blocked; then
  existing=$(gh api "repos/$repo/issues/$issue/comments" --paginate \
    --jq '.[] | select(.body | startswith("<!-- factory:blocker -->")) | .html_url' | tail -n 1)
  if [ -n "$existing" ]; then
    printf '%s\n' "$existing"
    exit 0
  fi
fi

body=$(mktemp)
trap 'rm -f "$body"' EXIT
{
  printf '%s\n\n' "$marker"
  printf '## Blocker\n\n'
  printf '@ranokay %s\n\n' "$reason"
  printf '**Unblock step:** %s\n\n' "$unblock"
  printf '**Last evidence:** %s\n\n' "${evidence:-none}"
  printf '**Open findings:** %s\n' "${findings:-none}"
} >"$body"

url=$(gh issue comment "$issue" -R "$repo" --body-file "$body")
if ! gh issue edit "$issue" -R "$repo" --add-label blocked; then
  printf 'block-issue: posted %s but the blocked label failed\n' "$url" >&2
  exit 1
fi
printf '%s\n' "$url"

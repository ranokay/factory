#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: block-issue <owner>/<repo> <issue> --reason <text> --unblock <text>
                    [--evidence <text>]... [--finding <text>]... [--detail <text>]...

Adds the blocked label and posts the Run's one Blocker comment. The comment
starts with a marker so blocker-notify.yml can find it. The comment is posted
before the label, so the labeled event always sees it.

The comment puts the unblock step first, as one command or question, then
mentions @ranokay with the reason. Last evidence and open findings follow as
one-line bullets; --detail renders longer text inside a collapsed block. If the
issue is already blocked with a Blocker comment, the script prints that
comment's URL and changes nothing.
EOF
}

marker='<!-- factory:blocker -->'

fail() {
  printf 'block-issue: %s\n' "$1" >&2
  exit 2
}

one_line() {
  if [ "$(printf '%s' "$2" | awk 'END { print NR }')" -ne 1 ]; then
    fail "$1 must be one line; put longer text in --detail"
  fi
}

script_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd)
# shellcheck source=skills/supervise/scripts/valid-repo.sh
# shellcheck disable=SC1091
. "$script_dir/valid-repo.sh"

[ "$#" -ge 2 ] || {
  usage >&2
  exit 2
}
repo=$1
issue=$2
shift 2
valid_repo "$repo" || fail "invalid repository $repo"
case $issue in
'' | *[!0-9]*) fail "issue must be a number" ;;
esac

reason=
unblock=
evidence=
findings=
detail=
while [ "$#" -gt 0 ]; do
  case $1 in
  --reason)
    [ "$#" -ge 2 ] || fail "missing value for --reason"
    reason=$(printf '%s\n' "$2")
    one_line --reason "$reason"
    shift 2
    ;;
  --unblock)
    [ "$#" -ge 2 ] || fail "missing value for --unblock"
    unblock=$(printf '%s\n' "$2")
    one_line --unblock "$unblock"
    shift 2
    ;;
  --evidence)
    [ "$#" -ge 2 ] || fail "missing value for --evidence"
    item=$(printf '%s' "$2" | sed 's/^[[:space:]]*//')
    case $item in
    '') fail "--evidence must not be empty" ;;
    -* | +* | \**) fail "--evidence must not start with a list marker" ;;
    esac
    one_line --evidence "$item"
    evidence="$evidence${evidence:+
}$item"
    shift 2
    ;;
  --finding)
    [ "$#" -ge 2 ] || fail "missing value for --finding"
    item=$(printf '%s' "$2" | sed 's/^[[:space:]]*//')
    case $item in
    '') fail "--finding must not be empty" ;;
    -* | +* | \**) fail "--finding must not start with a list marker" ;;
    esac
    one_line --finding "$item"
    findings="$findings${findings:+
}$item"
    shift 2
    ;;
  --detail)
    [ "$#" -ge 2 ] || fail "missing value for --detail"
    if printf '%s' "$2" | grep -qi '</details>'; then
      fail "--detail cannot contain </details>"
    fi
    escaped=$(printf '%s' "$2" | sed 's/@/\&#64;/g')
    detail="$detail${detail:+

}$escaped"
    shift 2
    ;;
  *)
    fail "unknown argument $1"
    ;;
  esac
done
[ -n "$reason" ] || fail "missing --reason"
[ -n "$unblock" ] || fail "missing --unblock"

labels=$(gh issue view "$issue" -R "$repo" --json labels --jq '.labels[].name')
if printf '%s\n' "$labels" | grep -qx blocked; then
  existing=$(gh api "repos/$repo/issues/$issue/comments" --paginate \
    --jq '.[] | select(.body | startswith("<!-- factory:blocker -->")) | .html_url' | tail -n 1)
  if [ -n "$existing" ]; then
    printf '%s\n' "$existing"
    exit 0
  fi
fi

body=$(mktemp)
trap 'rm -f "$body"' EXIT
{
  printf '%s\n\n' "$marker"
  printf '## Blocker\n\n'
  printf '**Unblock step:** %s\n\n' "$unblock"
  printf '@ranokay %s\n\n' "$reason"
  if [ -n "$evidence" ]; then
    printf '**Last evidence:**\n'
    printf '%s\n' "$evidence" | sed 's/^/- /'
  else
    printf '**Last evidence:** none\n'
  fi
  printf '\n'
  if [ -n "$findings" ]; then
    printf '**Open findings:**\n'
    printf '%s\n' "$findings" | sed 's/^/- /'
  else
    printf '**Open findings:** none\n'
  fi
  if [ -n "$detail" ]; then
    printf '\n<details>\n<summary>Details</summary>\n\n%s\n\n</details>\n' "$detail"
  fi
} >"$body"

url=$(gh issue comment "$issue" -R "$repo" --body-file "$body")
if ! gh issue edit "$issue" -R "$repo" --add-label blocked; then
  printf 'block-issue: posted %s but the blocked label failed\n' "$url" >&2
  exit 1
fi
printf '%s\n' "$url"

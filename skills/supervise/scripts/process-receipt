#!/bin/sh
set -eu

usage() {
  cat <<'EOF'
Usage: process-receipt baseline|check <worktree>

baseline records what is already running when a Run starts: every process
whose working directory or command line is inside <worktree>, and every
booted iOS simulator. check reports anything matching that is not in the
baseline, so harness processes and LSP servers recorded before the Run do
not fail it, while every dev server, watcher or simulator the Run started
does.

State lives under the agent state directory (`$XDG_STATE_HOME` or
`~/.local/state`) in `agent-tools/process-receipt`, keyed by the worktree path.
The script never reports itself or its parent chain.
EOF
}

fail() {
  printf 'process-receipt: %s\n' "$1" >&2
  exit 2
}

command=${1:-}
worktree=${2:-}
case $command in
baseline | check) ;;
*)
  usage >&2
  exit 2
  ;;
esac
[ -n "$worktree" ] || {
  usage >&2
  exit 2
}

[ "$#" -eq 2 ] || {
  usage >&2
  exit 2
}

root=$(cd "$worktree" 2>/dev/null && pwd -P) || fail "no such worktree: $worktree"
given=$(cd "$worktree" 2>/dev/null && pwd) || fail "no such worktree: $worktree"
cd /
state_root=${XDG_STATE_HOME:-"$HOME/.local/state"}/agent-tools/process-receipt
state_file=$state_root/$(printf '%s' "$root" | cksum | awk '{print $1}')

command -v lsof >/dev/null 2>&1 || fail "lsof is required"

excluded=' '
pid=$$
while :; do
  excluded="$excluded$pid "
  ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  [ -n "$ppid" ] || break
  [ "$ppid" -gt 1 ] || break
  pid=$ppid
done

cwd_pids() {
  ROOT=$root lsof -a -d cwd -Fpn 2>/dev/null | ROOT=$root awk '
    BEGIN { root = ENVIRON["ROOT"] }
    /^p/ { pid = substr($0, 2); next }
    /^n/ {
      path = substr($0, 2)
      if (path == root || index(path, root "/") == 1) print pid
    }
  '
}

argv_pids() {
  ROOT=$root GIVEN=$given ps -Ao pid=,command= | ROOT=$root GIVEN=$given awk '
    BEGIN {
      root = ENVIRON["ROOT"]
      given = ENVIRON["GIVEN"]
    }
    function one(s, needle,   p, c) {
      while ((p = index(s, needle)) > 0) {
        c = substr(s, p + length(needle), 1)
        if (c == "" || c !~ /[A-Za-z0-9._-]/) return 1
        s = substr(s, p + length(needle))
      }
      return 0
    }
    function mentions(s) {
      if (one(s, root)) return 1
      if (given != root && one(s, given)) return 1
      return 0
    }
    $1 ~ /^[0-9]+$/ && mentions($0) { print $1 }
  '
}

current_pids() {
  {
    cwd_pids
    argv_pids
  } | sort -u | while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    case " $excluded " in
    *" $pid "*) continue ;;
    esac
    command_line=$(ps -o command= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//')
    [ -n "$command_line" ] || continue
    case $command_line in
    *"$0"*) continue ;;
    esac
    printf '%s\n' "$pid"
  done
}

booted_sims() {
  command -v xcrun >/dev/null 2>&1 || return 0
  xcrun simctl list devices booted 2>/dev/null | awk '
    /\(Booted\)/ {
      line = $0
      if (match(line, /\([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\)/)) {
        print substr(line, RSTART + 1, RLENGTH - 2)
      }
    }
  '
}

baseline() {
  mkdir -p "$state_root"
  pids=$(current_pids)
  sims=$(booted_sims)
  {
    printf '%s\n' "$pids" | sed '/^$/d; s/^/p /'
    printf '%s\n' "$sims" | sed '/^$/d; s/^/s /'
  } | sort -u >"$state_file"
  printf 'recorded %s processes and %s simulators\n' \
    "$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l | tr -d ' ')" \
    "$(printf '%s\n' "$sims" | sed '/^$/d' | wc -l | tr -d ' ')"
}

check() {
  [ -f "$state_file" ] || fail "no baseline for $root; run process-receipt baseline $root before starting processes"
  status=0
  new=$(current_pids | while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    if ! grep -qx "p $pid" "$state_file"; then
      printf '%s\n' "$pid"
    fi
  done)
  if [ -n "$new" ]; then
    status=1
    printf 'processes: %s running\n' "$(printf '%s\n' "$new" | wc -l | tr -d ' ')"
    for pid in $new; do
      printf 'pid %s: %s\n' "$pid" "$(ps -o command= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//')"
    done
  else
    printf 'processes: none\n'
  fi
  sims=$(booted_sims)
  if [ -z "$sims" ]; then
    if command -v xcrun >/dev/null 2>&1; then
      printf 'simulators: none\n'
    else
      printf 'simulators: not checked (no xcrun)\n'
    fi
  else
    for sim in $sims; do
      if grep -qx "s $sim" "$state_file"; then
        printf 'simulator %s: pre-existing\n' "$sim"
      else
        printf 'simulator %s: new\n' "$sim"
        status=1
      fi
    done
  fi
  exit "$status"
}

case $command in
baseline) baseline ;;
check) check ;;
esac

#!/usr/bin/env python3

from __future__ import annotations

import re
import sys


def normalize(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", value.lower()).strip()


def main() -> int:
    text = sys.stdin.read().strip()
    normalized = normalize(text)
    if re.search(
        r"\b(?:checks?|ci)\s+(?:(?:are|is|remain|remains|still)\s+)*(?:pending|running)\b"
        r"|\b(?:pending|waiting for)\s+(?:required\s+)?(?:checks?|ci)\b",
        normalized,
    ):
        print("stopped-notice: pending checks cannot be a stopped notice; wait with gh run watch <id> --exit-status", file=sys.stderr)
        return 2
    for line in text.splitlines():
        if not line.lower().startswith("unblock:"):
            continue
        value = normalize(line.split(":", 1)[1])
        if (
            re.search(r"\b(?:resume|continue|proceed|retry)\b", value)
            and re.search(r"\b(?:checks?|ci)\b", value)
            and re.search(r"\b(?:finish|finished|complete|completed|pass|passed|green|done)\b", value)
        ):
            print("stopped-notice: a pending-check unblock step cannot defer the wait to a later resume", file=sys.stderr)
            return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

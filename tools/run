#!/bin/sh
set -eu
tool_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ "$#" -eq 0 ]; then
  echo 'Usage: run {command_guard|environment_check|tests} [arguments...]' >&2
  exit 2
fi
tool=$1
shift
case "$tool" in
command_guard | environment_check)
  exec uv run --offline --no-project --no-config --python 3.13 python "$tool_dir/$tool.py" "$@"
  ;;
tests)
  exec uv run --offline --no-project --no-config --python 3.13 python -m unittest discover -s "$tool_dir/tests" "$@"
  ;;
*)
  echo "Unknown agent tool: $tool" >&2
  exit 2
  ;;
esac
